# ==============================================================================
# Festiva AI — Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (NEVER COMMIT REAL SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# ------------------------------------------------------------------------------
# 2. Node & Frontend Dependencies and Build Outputs
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments, Bytecode & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pytype/
.ruff_cache/

# Distribution & Packaging
*.egg-info/
*.egg
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# ------------------------------------------------------------------------------
# 4. Databases, Local Storage & State
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
local_storage/
*.bak

# ------------------------------------------------------------------------------
# 5. Operating System & IDE Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Linux
*~

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 6. Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
