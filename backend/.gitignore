# ==============================================================================
# Festiva AI — Backend .gitignore
# ==============================================================================

# Environment files with credentials
.env
.env.*
!.env.example
!.env.*.example
*.env

# Python byte code and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Testing & cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Distribution & packaging
*.egg-info/
dist/
build/

# Local databases & logs
*.sqlite
*.sqlite3
*.db
*.log

