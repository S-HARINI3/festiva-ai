# ==============================================================================
# Festiva AI — Frontend .gitignore
# ==============================================================================

# Environment files
.env
.env.*
!.env.example
!.env.*.example
*.local

# Dependencies & Build
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
